# Copy to .env (untracked) and fill in what you need. Checkout can be simulated,
# but officer cards require a Stripe sandbox key and are never mocked.

# ── OpenRouter (JEV, the risk analyst: Jev decision model via the Decisions API) ─────────────────────────────────────
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.13
# Optional chat-capable OpenRouter model for annual-report prose. Empty uses a labelled template.
GRANT_DRAFT_MODEL=
JEV_TIMEOUT_MS=3000

# ── Stripe (sandbox only; the app refuses to start with sk_live_) ─────────────
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=
# Optional: a pre-created €49/year Price. If empty, Checkout uses inline price_data.
STRIPE_SOCIETY_PLAN_PRICE_ID=
# Stripe Issuing must be enabled on the sandbox. Every card shown in Balance is
# created through the site and backed by a Stripe virtual card.

APP_URL=http://localhost:3000
