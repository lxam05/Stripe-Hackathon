# Copy to .env.local. Every key is optional: without them Balance runs fully
# locally with a simulated checkout, the MockAdapter card network and rules-only risk.

# ── OpenRouter (JEV, the AI risk analyst) ─────────────────────────────────────
OPENROUTER_API_KEY=
JEV_MODEL=anthropic/claude-haiku-5.5
JEV_TIMEOUT_MS=8000

# ── Stripe (sandbox only; the app refuses to start with sk_live_) ─────────────
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=
# Optional: a pre-created €49/year Price. If empty, Checkout uses inline price_data.
STRIPE_SOCIETY_PLAN_PRICE_ID=
# "stripe" issues real sandbox virtual cards via Stripe Issuing (needs Issuing enabled
# on the account). Anything else uses the local MockAdapter.
ISSUING_MODE=mock

APP_URL=http://localhost:3000
